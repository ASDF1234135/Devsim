# Goal-card constructor (plan §2.4): any OpenAI-compatible LOCAL server (Ollama, vLLM, LM Studio)
GOAL_CARD_BASE_URL=http://localhost:11434/v1
GOAL_CARD_MODEL=qwen3.5:latest
# local servers accept any non-empty key
GOAL_CARD_API_KEY=local
# keep within the server's context window (Ollama defaults to 4096 tokens)
GOAL_CARD_MAX_INPUT_CHARS=8000
GOAL_CARD_MAX_TOKENS=900
# "none" turns off thinking on Ollama; leave empty for servers that reject the field
GOAL_CARD_REASONING_EFFORT=none
GOAL_CARD_TIMEOUT_S=900
